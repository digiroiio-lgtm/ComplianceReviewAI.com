# Canonical origin of the site (no trailing slash). Used for canonical URLs,
# sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://compliancereviewai.com

# Where the sitewide "domain for sale" banner links to.
# Leave unset to use the built-in /domain page. Can be an external URL.
# NEXT_PUBLIC_DOMAIN_SALE_URL=https://example.com/compliancereviewai-com

# Contact method for the "Make an Inquiry" button on /domain.
# Accepts mailto:, https:// form links, etc. Placeholder default is used if unset.
# NEXT_PUBLIC_DOMAIN_CONTACT_URL=mailto:you@example.com
